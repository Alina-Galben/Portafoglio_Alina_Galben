{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    
    /* Configurazione Ibrida JS/TS */
    "strict": true,
    "noImplicitAny": false,      /* Permette di non essere troppo severi */
    "allowJs": true,             /* FONDAMENTALE: Accetta i file .jsx e .js */
    
    /* Tipi globali */
    "types": ["vite/client", "node"]
  },
  "include": ["src"]
}